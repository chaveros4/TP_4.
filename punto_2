#include <iostream>
#include <vector>
using namespace std;

void cargarVector(vector<int>& v)
{
    for (int i = 0; i < 5; i++) {
        cout << "Ingrese el elemento " << i + 1 << ": ";
        cin >> v[i];
    }
}

void mostrarVector(vector<int> v)
{
    cout << "Vector: ";

    for (int x : v) {
        cout << x << " ";
    }

    cout << endl;
}

int main()
{
    vector<int> v(5);

    cargarVector(v);
    mostrarVector(v);

    return 0;
}
