#include <iostream>
#include <vector>
using namespace std;

int main()
{
    vector<int> v(8);

    int acumulado = 0;
    int acumuladoMayores36 = 0;
    int cantidadMayores50 = 0;

    cout << "Ingrese 8 elementos:" << endl;

    for (int i = 0; i < 8; i++) {
        cin >> v[i];

        acumulado += v[i];

        if (v[i] > 36) {
            acumuladoMayores36 += v[i];
        }

        if (v[i] > 50) {
            cantidadMayores50++;
        }
    }

    cout << "Valor acumulado de todos los elementos: " << acumulado << endl;
    cout << "Valor acumulado de los mayores a 36: " << acumuladoMayores36 << endl;
    cout << "Cantidad de valores mayores a 50: " << cantidadMayores50 << endl;

    return 0;
}
